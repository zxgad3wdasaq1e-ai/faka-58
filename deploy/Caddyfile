# No upstream proxy is trusted unless Cloudflare mode is selected explicitly.
(direct) {
    client_ip_headers X-Forwarded-For
}

# Official ranges checked on 2026-10-21: https://www.cloudflare.com/ips/
(cloudflare) {
    trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
    trusted_proxies_strict
    client_ip_headers CF-Connecting-IP
}

{
    servers {
        import {$CADDY_PROXY_MODE:direct}
    }
}

(storefront_proxy) {
    reverse_proxy app:8080 {
        # Forward one verified address so Gin only needs to trust Caddy's /32.
        header_up X-Forwarded-For {client_ip}
        header_up X-Real-IP {client_ip}
        header_up -CF-Connecting-IP
    }
}

{$SITE_ADDRESS:http://localhost} {
    encode zstd gzip
    request_body {
        max_size 12MB
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
    import storefront_proxy
}
